name: Update Jira Data
on:
  schedule:
    - cron: '0 * * * *' # Se ejecuta cada hora automáticamente
  workflow_dispatch: # Permite ejecutarlo manualmente con un botón

jobs:
  build:
    runs-on: ubuntu-latest
    permissions: # Permisos explícitos de escritura
      contents: write
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4 # Actualizado de v2 a v4

      - name: Fetch Data from Jira
        run: |
          curl -u ${{ secrets.JIRA_EMAIL }}:${{ secrets.JIRA_TOKEN }} \
          -X GET "https://tdentel.atlassian.net/rest/api/3/search?jql=project=BURC+AND+statusCategory!=Done" \
          -H "Content-Type: application/json" > data.json

      - name: Commit and Push
        run: |
          git config --global user.name "JiraDataBot"
          git config --global user.email "bot@github.com"
          git add data.json
          git commit -m "🔄 Actualización automática de datos Jira" || exit 0
          git push
